{
  "name": "editorial",
  "formats": [
    "short-form-explainer",
    "short-form-raw",
    "long-form"
  ],
  "colors": {
    "bg": "$bg",
    "rule": "$rule",
    "accent": "$accent",
    "accent_soft": "$accent-soft",
    "ink": "$ink",
    "muted": "$muted"
  },
  "fonts": {
    "display": "$font.display",
    "caption": "$font.caption"
  },
  "captions": {
    "short-form-explainer": {
      "enabled": true,
      "font": "$font.caption",
      "size_px": 56,
      "case": "sentence",
      "max_chars_per_line": 24,
      "max_lines": 2,
      "position_y": 1450,
      "fill": "$ink",
      "box": {
        "fill": "$bg",
        "opacity": 0.88,
        "radius_px": 0,
        "pad_px": 20
      },
      "highlight": {
        "mode": "word",
        "fill": "$accent"
      },
      "line_height": 1.35,
      "anchor": "bottom",
      "block_bottom_y": 1600,
      "never_overlap_pip": true,
      "voice": "$caption_voice"
    },
    "short-form-raw": {
      "enabled": true,
      "font": "$font.caption",
      "size_px": 56,
      "case": "sentence",
      "max_chars_per_line": 24,
      "max_lines": 2,
      "position_y": 1450,
      "fill": "$ink",
      "box": {
        "fill": "$bg",
        "opacity": 0.88,
        "radius_px": 0,
        "pad_px": 20
      },
      "highlight": {
        "mode": "word",
        "fill": "$accent"
      },
      "line_height": 1.35,
      "anchor": "bottom",
      "block_bottom_y": 1600,
      "never_overlap_pip": true,
      "voice": "$caption_voice"
    },
    "long-form": {
      "enabled": false
    }
  },
  "hook": {
    "required": true,
    "kind": "card",
    "duration_s": 2.5,
    "max_start_s": 1.5,
    "source": "verbatim-line-from-footage",
    "pay_off_within_s": 15,
    "fabricated_claims": false,
    "fallback": "sharpest true claim in the first 60s, verbatim, flag in review"
  },
  "graphics": {
    "kinds": [
      "stat",
      "card",
      "screenshot",
      "takeover",
      "zoom",
      "diagram",
      "broll-slot"
    ],
    "density": {
      "short-form-explainer": {
        "lines_per_graphic": 5
      },
      "short-form-raw": {
        "max_graphics": 1
      },
      "long-form": {
        "lines_per_graphic": 10
      }
    },
    "min_duration_s": 2.5,
    "max_duration_s": 6.0,
    "max_consecutive": 2,
    "tail_margin_s": 0.5,
    "continuous_motion_threshold_s": 20,
    "stagger_s": 0.4,
    "instant_change_duration_s": 0.25,
    "pip": {
      "short-form": {
        "w": 540,
        "h": 680,
        "x": "center",
        "y": 680,
        "radius_px": 0,
        "border_px": 1,
        "border_color": "$rule",
        "enters_once_per_run": true
      },
      "long-form": {
        "w": 480,
        "h": 270,
        "right_px": 108,
        "bottom_px": 108,
        "radius_px": 0,
        "border_px": 1,
        "border_color": "$rule"
      },
      "enters_once_per_run": true
    },
    "safe_zones": {
      "short-form": {
        "w": 1080,
        "h": 1920,
        "top_px": 200,
        "bottom_px": 300
      },
      "long-form": {
        "w": 1920,
        "h": 1080,
        "margin_pct": 10,
        "outro_clear_right_pct": 40
      }
    },
    "drift": {
      "scale_from": 1.0,
      "scale_to": 1.03,
      "ease": "none"
    },
    "eases": {
      "enter": "power3.out",
      "exit": "power2.inOut",
      "zoom": "power2.inOut"
    },
    "stat_min_px": 160,
    "zones": {
      "short-form": {
        "graphics_y": [
          200,
          660
        ],
        "face_y": [
          680,
          1360
        ],
        "captions_y": [
          1410,
          1600
        ]
      }
    },
    "payoff_interval_s": [
      8,
      10
    ],
    "first_visual_change_by_s": 3
  },
  "audio": {
    "music_db": -18,
    "music_duck": false,
    "music_fade_in": false,
    "music_fade_out_s": 2.0,
    "sfx_db": -10,
    "sfx_max_per_minute": 3
  },
  "qa": {
    "duplicate_frame_fail_pct": 8,
    "duplicate_frame_clean_pct": 3,
    "segment_gamma_correction": 1.03,
    "early_spot_review_at_pct": 10
  },
  "learned": [],
  "surfaces": {
    "panel": "#131417",
    "button_border": "#4A4A4C",
    "on_accent": "#FFF7F2",
    "accent_pressed": "#97482C",
    "body_text": "#EDEBE6"
  },
  "type": {
    "radius_px": 0,
    "display_weight": 400,
    "headline_tracking_em": -0.01,
    "headline_line_height": 1.15,
    "body_line_height": 1.65,
    "quote_line_height": 1.5,
    "label_tracking_em": 0.14,
    "label_case": "upper",
    "headline_measure_ch": 16,
    "accent_min_text_px": 48
  },
  "primary_format": "short-form-explainer"
}
